{
  "name": "traxxer",
  "version": "1.0.0",
  "description": "Software de DJing com Electron e C#",
  "main": "frontend/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "dist": "electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msolot1023/traxxer.git"
  },
  "keywords": [
    "dj",
    "electron",
    "c++",
    "música"
  ],
  "author": "Tomás Pinto",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/msolot1023/traxxer/issues"
  },
  "homepage": "https://github.com/msolot1023/traxxer#readme",
  "devDependencies": {
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "electron": "^39.8.7",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1",
    "nodemon": "^3.1.14"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "essentia.js": "^0.1.3",
    "jsmediatags": "^3.9.7",
    "soundtouchjs": "^0.3.0",
    "wavesurfer.js": "^7.12.5"
  },
  "build": {
    "appId": "com.tomaspinto.traxxer",
    "productName": "Traxxer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "frontend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/bin",
        "to": "backend/bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["portable"],
      "icon": "frontend/assets/icon/icon.ico"
    }
  }
}
